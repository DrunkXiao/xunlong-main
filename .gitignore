# ---------------- Python ----------------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---------------- 虚拟环境 ----------------
.venv/
venv/
env/

# ---------------- 本地运行配置 ----------------
# config.yaml 含本机绝对路径（如通达信安装目录），不入库；
# 模板见 config.example.yaml
config.yaml

# ---------------- 运行数据 ----------------
# SQLite 行情库、导出报告、日志都是运行产物，体积大且可重建
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/logs/
data/reports/
data/backup*/
*.log

# ---------------- 打包产物 ----------------
build/
dist/
*.exe
!run.spec

# ---------------- 调试产物 ----------------
# 早期排查时渲染到 docs/ 根目录的探针截图，不属于正式文档
docs/*_probe.png

# ---------------- 临时目录 ----------------
.tmp_*/
.tmp/
*.tmp

# ---------------- 智能体工作区 ----------------
# 技能文档入库，个人工作日志不入库
.workbuddy/memory/

# ---------------- 编辑器 / 系统 ----------------
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini
